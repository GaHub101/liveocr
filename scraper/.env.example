# Apps-Script-Webhook (dieselbe Deployment-URL wie die App)
APPS_SCRIPT_URL=https://script.google.com/macros/s/DEINE_DEPLOYMENT_ID/exec

# Separates Secret NUR für den Scraper (getWorkList + pushPrices).
# Muss identisch als SCRAPER_PUSH_SECRET in den Apps Script Script Properties stehen.
# NICHT das client-sichtbare WEBHOOK_SECRET verwenden!
SCRAPER_PUSH_SECRET=dein-scraper-secret

# Optional: DEBUG=1 setzt das Log-Level auf debug (wie --debug)
# DEBUG=1

# Zugangsdaten pro Shop als JSON. Schlüssel = SHOP_CRED_<KEY>,
# <KEY> = Lieferantenname uppercase, Umlaute transliteriert (Ä→AE …),
# Sonderzeichen → "_" (z. B. "Henry Schein" → SHOP_CRED_HENRY_SCHEIN).
# Der Name muss exakt dem "Lieferant" in PreisConfig entsprechen.
# SHOP_CRED_HENRY_SCHEIN={"user":"kundennr@example.de","pass":"geheim"}
